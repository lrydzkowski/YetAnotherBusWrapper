{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure": "Warning",
      "YetAnotherBusWrapper": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "Sample": {
    "InstanceName": "",
    "UseCustomMessageSerializer": false,
    "DisableHostedServices": false
  },
  "ServiceBus": {
    "ConnectionString": "",
    "AdministrationConnectionString": "",
    "ClientRetry": {
      "MaxRetries": 3,
      "TryTimeout": "00:00:10",
      "MaxDelay": "00:00:05"
    },
    "Orders": {
      "QueueName": "sample-orders",
      "CreateOnStartup": true,
      "FailStartupOnProvisioningError": true,
      "MaxDeliveryCount": 5,
      "Consumer": {
        "MaxConcurrentCalls": 4,
        "PrefetchCount": 8,
        "MaxAutoLockRenewalDuration": "00:10:00"
      }
    },
    "Payments": {
      "QueueName": "sample-payments",
      "CreateOnStartup": true,
      "MaxDeliveryCount": 3
    },
    "Shipments": {
      "QueueName": "sample-shipments",
      "CreateOnStartup": true,
      "HealthCheck": "Peek",
      "Consumer": {
        "SessionsEnabled": true,
        "MaxConcurrentSessions": 4,
        "SessionIdleTimeout": "00:00:30"
      }
    },
    "Reports": {
      "QueueName": "sample-reports",
      "CreateOnStartup": true,
      "Consumer": {
        "MaxConcurrentCalls": 8
      }
    },
    "Audit": {
      "Enabled": false,
      "QueueName": "sample-audit"
    },
    "Prices": {
      "TopicName": "sample-prices",
      "CreateOnStartup": true,
      "DuplicateDetectionWindow": "00:10:00",
      "Cache": {
        "SubscriptionName": "cache",
        "CreateOnStartup": true
      },
      "Search": {
        "SubscriptionName": "search",
        "CreateOnStartup": true,
        "MaxConcurrentCalls": 2
      }
    },
    "CacheInvalidation": {
      "TopicName": "sample-cache-invalidation",
      "CreateOnStartup": true,
      "LocalCache": {
        "SubscriptionName": "sample",
        "UseInstanceSuffix": true,
        "CreateOnStartup": true,
        "DeleteOnShutdown": true
      }
    },
    "Notifications": {
      "Enabled": true,
      "TopicName": "sample-notifications",
      "CreateOnStartup": true,
      "BestEffort": true,
      "Email": {
        "SubscriptionName": "email",
        "CreateOnStartup": true
      }
    }
  }
}
